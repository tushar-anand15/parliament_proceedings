[Unit]
Description=Parliament API Flower (Celery Monitoring)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=tusharanand
Group=tusharanand
WorkingDirectory=/home/tusharanand/parliament_proceedings/parliament_api

# Environment
EnvironmentFile=/home/tusharanand/parliament_proceedings/parliament_api/.env
Environment="DJANGO_SETTINGS_MODULE=parliament_api.settings"

# Start Flower
ExecStart=/home/tusharanand/parliament_proceedings/env/bin/celery -A parliament_api flower \
    --port=5555 \
    --address=127.0.0.1 \
    --url_prefix=flower \
    --persistent=True \
    --db=/home/tusharanand/parliament_proceedings/parliament_api/flower.db \
    --max_tasks=10000

# Restart policy
Restart=always
RestartSec=10
StandardOutput=append:/var/log/parliament_api/flower.log
StandardError=append:/var/log/parliament_api/flower-error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target


