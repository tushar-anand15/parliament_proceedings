[Unit]
Description=Parliament API Celery Beat Scheduler
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=tusharanand
Group=tusharanand
WorkingDirectory=/home/tusharanand/parliament_proceedings/parliament_api

# Environment
EnvironmentFile=/home/tusharanand/parliament_proceedings/parliament_api/.env
Environment="DJANGO_SETTINGS_MODULE=parliament_api.settings"

# Start Celery Beat
ExecStart=/home/tusharanand/parliament_proceedings/env/bin/celery -A parliament_api beat \
    --loglevel=info \
    --logfile=/var/log/parliament_api/celery-beat.log \
    --pidfile=/run/parliament_api/celery-beat.pid

# Restart policy
Restart=always
RestartSec=10
StandardOutput=append:/var/log/parliament_api/celery-beat.log
StandardError=append:/var/log/parliament_api/celery-beat-error.log

# Create PID directory
RuntimeDirectory=parliament_api
RuntimeDirectoryMode=0755

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target


