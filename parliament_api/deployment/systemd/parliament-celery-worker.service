[Unit]
Description=Parliament API Celery Worker
After=network.target redis.service postgresql.service
Wants=redis.service postgresql.service

[Service]
Type=exec
User=tusharanand
Group=tusharanand
WorkingDirectory=/home/tusharanand/parliament_proceedings/parliament_api

# Environment
EnvironmentFile=/home/tusharanand/parliament_proceedings/parliament_api/.env
Environment="DJANGO_SETTINGS_MODULE=parliament_api.settings"
Environment="C_FORCE_ROOT=true"

# Start Celery Worker (no --detach for systemd)
ExecStart=/home/tusharanand/parliament_proceedings/env/bin/celery -A parliament_api worker \
    --loglevel=info \
    --concurrency=8 \
    --max-tasks-per-child=1000

# Stop Celery Worker
ExecStop=/bin/kill -s TERM $MAINPID

# Restart policy
Restart=always
RestartSec=10
StandardOutput=append:/var/log/parliament_api/celery-worker.log
StandardError=append:/var/log/parliament_api/celery-worker-error.log

# Create PID directory
RuntimeDirectory=parliament_api
RuntimeDirectoryMode=0755

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
